# FastAPI + PostgreSQL. Copy to .env and adjust the password if needed.
LEARNINGTREE_DATABASE_URL=postgresql+psycopg://learningtree:change-me@127.0.0.1:5432/learningtree
# Local development: 127.0.0.1:8000. Devbox: bind 0.0.0.0 to the exposed port (8000).
LEARNINGTREE_API_HOST=127.0.0.1
LEARNINGTREE_API_PORT=8000
# Set true when the app is served over HTTPS (Sealos Devbox ingress).
LEARNINGTREE_COOKIE_SECURE=false
LEARNINGTREE_SESSION_TTL_DAYS=7
LEARNINGTREE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
# Optional: path to the Python executable used by npm run dev.
# LEARNINGTREE_PYTHON=.venv/Scripts/python.exe
